{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/search", "destination": "/api/index" },
    { "source": "/api/api-status", "destination": "/api/index" },
    { "source": "/api/analyze", "destination": "/api/index" },
    { "source": "/api/articles", "destination": "/api/index" },
    { "source": "/api/articles/:id", "destination": "/api/index" },
    { "source": "/api/games/compare-pair", "destination": "/api/index" },
    { "source": "/api/games/headline-rewrite/score", "destination": "/api/index" },
    { "source": "/api/narratives", "destination": "/api/index" },
    { "source": "/:path((?!api/|assets/|favicon).*)", "destination": "/index.html" }
  ]
}
