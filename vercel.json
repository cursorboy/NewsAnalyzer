{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/search", "destination": "/api/index" },
    { "source": "/articles/:id", "destination": "/api/index" },
    { "source": "/analyze", "destination": "/api/index" },
    { "source": "/api-status", "destination": "/api/index" },
    { "source": "/games/compare-pair", "destination": "/api/index" },
    { "source": "/games/headline-rewrite/score", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
